<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ronix_pwa_app_tree" model="ir.ui.view">
        <field name="name">ronix.pwa.app.tree</field>
        <field name="model">ronix.pwa.app</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="name"/>
                <field name="short_name"/>
                <field name="website_id"/>
                <field name="match_path"/>
                <field name="match_mode"/>
                <field name="start_url"/>
                <field name="scope_path"/>
                <field name="display"/>
            </list>
        </field>
    </record>

    <record id="view_ronix_pwa_app_form" model="ir.ui.view">
        <field name="name">ronix.pwa.app.form</field>
        <field name="model">ronix.pwa.app</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_start_url" type="object" string="Open Start URL" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Ronix Mobile"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="website_id"/>
                            <field name="short_name"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="display"/>
                            <field name="theme_color"/>
                            <field name="background_color"/>
                            <field name="install_button_enabled"/>
                            <field name="button_label" invisible="not install_button_enabled"/>
                            <field name="install_button_path" invisible="not install_button_enabled" placeholder="/ronix/mobile"/>
                            <field name="install_button_match_mode" invisible="not install_button_enabled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Routing">
                            <group>
                                <group>
                                    <field name="match_path" placeholder="/ronix/mobile"/>
                                    <field name="match_mode"/>
                                    <field name="start_url" placeholder="/ronix/mobile"/>
                                    <field name="scope_path" placeholder="/ronix/mobile"/>
                                </group>
                                <group>
                                    <field name="app_uid" readonly="1"/>
                                    <field name="manifest_url" readonly="1"/>
                                    <field name="service_worker_url" readonly="1"/>
                                    <field name="public_start_url" readonly="1"/>
                                </group>
                            </group>
                            <group col="1">
                                <div class="text-muted">
                                    Use Exact Path when only one page should expose this manifest. Use Path Prefix when all pages under the path should behave as the same installed app.
                                </div>
                                <div class="text-muted" invisible="not install_button_enabled">
                                    The install button is controlled separately. Leave Install Button Path empty to show it only on the Start URL.
                                </div>
                            </group>
                        </page>
                        <page string="Branding">
                            <group>
                                <group>
                                    <field name="icon_image" widget="image" class="oe_avatar" options="{'preview_image': 'icon_image'}"/>
                                </group>
                                <group>
                                    <div class="text-muted">
                                        One uploaded image is automatically served as 192x192, 512x512, and Apple touch icon sizes.
                                    </div>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ronix_pwa_app_search" model="ir.ui.view">
        <field name="name">ronix.pwa.app.search</field>
        <field name="model">ronix.pwa.app</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="short_name"/>
                <field name="match_path"/>
                <field name="website_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactive" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Website" name="group_website" context="{'group_by': 'website_id'}"/>
                    <filter string="Display" name="group_display" context="{'group_by': 'display'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ronix_pwa_app" model="ir.actions.act_window">
        <field name="name">PWA Apps</field>
        <field name="res_model">ronix.pwa.app</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ronix_pwa_app_search"/>
        <field name="help" type="html">
            <p>Create installable PWAs for exact paths or path prefixes.</p>
            <p>Each record can use its own name, logo, scope, and install button label.</p>
        </field>
    </record>
</odoo>
