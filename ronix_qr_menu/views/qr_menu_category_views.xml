<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_qr_menu_category_list" model="ir.ui.view">
        <field name="name">qr.menu.category.list</field>
        <field name="model">qr.menu.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="restaurant_id"/>
                <field name="name"/>
                <field name="item_count"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_qr_menu_category_form" model="ir.ui.view">
        <field name="name">qr.menu.category.form</field>
        <field name="model">qr.menu.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Category Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="restaurant_id"/>
                            <field name="icon" placeholder="e.g. ri-restaurant-line"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="item_count"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Category description..."/>
                    <separator string="Items"/>
                    <field name="item_ids">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="price" widget="monetary"/>
                            <field name="is_available" widget="boolean_toggle"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_qr_menu_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">qr.menu.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_qr_menu_category"
              name="Categories"
              parent="menu_qr_menu_root"
              action="action_qr_menu_category"
              sequence="30"/>
</odoo>
