<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_qr_menu_restaurant_list" model="ir.ui.view">
        <field name="name">qr.menu.restaurant.list</field>
        <field name="model">qr.menu.restaurant</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone"/>
                <field name="is_open" widget="boolean_toggle"/>
                <field name="table_count"/>
                <field name="item_count"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_qr_menu_restaurant_kanban" model="ir.ui.view">
        <field name="name">qr.menu.restaurant.kanban</field>
        <field name="model">qr.menu.restaurant</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="image_1920"/>
                <field name="is_open"/>
                <field name="table_count"/>
                <field name="item_count"/>
                <templates>
                    <t t-name="card">
                        <aside>
                            <field name="image_1920" widget="image" options="{'preview_image': 'image_1920', 'size': [100, 100]}"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold fs-5"/>
                            <div class="text-muted">
                                <span><field name="table_count"/> Tables</span> ·
                                <span><field name="item_count"/> Items</span>
                            </div>
                            <field name="is_open" widget="boolean_toggle"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_qr_menu_restaurant_form" model="ir.ui.view">
        <field name="name">qr.menu.restaurant.form</field>
        <field name="model">qr.menu.restaurant</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="is_open" widget="boolean_toggle" class="oe_inline"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Restaurant Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="address"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                        <group>
                            <field name="manager_ids" widget="many2many_tags"/>
                            <field name="qr_url" widget="CopyClipboardChar"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Restaurant description..."/>
                    <notebook>
                        <page string="Tables" name="tables">
                            <field name="table_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="capacity"/>
                                    <field name="qr_url" widget="CopyClipboardChar"/>
                                    <field name="active" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Categories" name="categories">
                            <field name="category_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="item_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Menu Items" name="items">
                            <field name="item_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="category_id"/>
                                    <field name="price" widget="monetary"/>
                                    <field name="is_available" widget="boolean_toggle"/>
                                    <field name="has_ar"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_qr_menu_restaurant" model="ir.actions.act_window">
        <field name="name">Restaurants</field>
        <field name="res_model">qr.menu.restaurant</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Root Menu -->
    <menuitem id="menu_qr_menu_root"
              name="QR Menu"
              web_icon="ronix_qr_menu,static/description/icon.png"
              sequence="100"/>

    <menuitem id="menu_qr_menu_restaurant"
              name="Restaurants"
              parent="menu_qr_menu_root"
              action="action_qr_menu_restaurant"
              sequence="10"/>
</odoo>
