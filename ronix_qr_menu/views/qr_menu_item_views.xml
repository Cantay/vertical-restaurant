<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_qr_menu_item_list" model="ir.ui.view">
        <field name="name">qr.menu.item.list</field>
        <field name="model">qr.menu.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="restaurant_id"/>
                <field name="category_id"/>
                <field name="price" widget="monetary"/>
                <field name="is_available" widget="boolean_toggle"/>
                <field name="is_vegetarian"/>
                <field name="is_vegan"/>
                <field name="is_spicy"/>
                <field name="has_ar"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_qr_menu_item_kanban" model="ir.ui.view">
        <field name="name">qr.menu.item.kanban</field>
        <field name="model">qr.menu.item</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="image_1920"/>
                <field name="price"/>
                <field name="category_id"/>
                <field name="is_available"/>
                <field name="has_ar"/>
                <templates>
                    <t t-name="card">
                        <aside>
                            <field name="image_1920" widget="image" options="{'preview_image': 'image_1920', 'size': [100, 100]}"/>
                        </aside>
                        <main>
                            <field name="name" class="fw-bold"/>
                            <field name="category_id" class="text-muted"/>
                            <div>
                                <field name="price" widget="monetary"/>
                                <span t-if="record.has_ar.raw_value" class="badge bg-info ms-1">AR</span>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_qr_menu_item_form" model="ir.ui.view">
        <field name="name">qr.menu.item.form</field>
        <field name="model">qr.menu.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Unavailable" bg_color="bg-warning" invisible="is_available"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Item Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="restaurant_id"/>
                            <field name="category_id"/>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="preparation_time"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="is_available"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Short description..."/>
                    <notebook>
                        <page string="Ingredients &amp; Allergens" name="content">
                            <group>
                                <field name="ingredients" widget="html"/>
                            </group>
                            <group string="Allergens">
                                <field name="allergen_ids" widget="many2many_tags" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Nutrition" name="nutrition">
                            <group>
                                <group>
                                    <field name="calories"/>
                                    <field name="protein"/>
                                </group>
                                <group>
                                    <field name="carbs"/>
                                    <field name="fat"/>
                                </group>
                            </group>
                        </page>
                        <page string="Diet Tags" name="diet">
                            <group>
                                <group>
                                    <field name="is_vegetarian"/>
                                    <field name="is_vegan"/>
                                </group>
                                <group>
                                    <field name="is_gluten_free"/>
                                    <field name="is_spicy"/>
                                </group>
                            </group>
                        </page>
                        <page string="AR / 3D Model" name="ar">
                            <group>
                                <field name="ar_model_3d" filename="ar_model_filename"/>
                                <field name="ar_model_filename" invisible="1"/>
                                <field name="has_ar"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_qr_menu_item" model="ir.actions.act_window">
        <field name="name">Menu Items</field>
        <field name="res_model">qr.menu.item</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_qr_menu_item"
              name="Menu Items"
              parent="menu_qr_menu_root"
              action="action_qr_menu_item"
              sequence="40"/>
</odoo>
