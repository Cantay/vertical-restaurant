<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Module Category -->
        <record id="module_category_qr_menu" model="ir.module.category">
            <field name="name">QR Menu</field>
            <field name="sequence">50</field>
        </record>

        <!-- User Group -->
        <record id="group_qr_menu_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_qr_menu"/>
        </record>

        <!-- Manager Group -->
        <record id="group_qr_menu_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_qr_menu"/>
            <field name="implied_ids" eval="[(4, ref('group_qr_menu_user'))]"/>
        </record>

        <!-- Admin Group -->
        <record id="group_qr_menu_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_qr_menu"/>
            <field name="implied_ids" eval="[(4, ref('group_qr_menu_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
