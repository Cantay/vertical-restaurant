<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Restaurant Rules -->
        <record id="rule_food_restaurant_manager" model="ir.rule">
            <field name="name">Shop Manager: Assigned Restaurants Only</field>
            <field name="model_id" ref="model_food_restaurant"/>
            <field name="groups" eval="[(4, ref('group_food_shop_manager'))]"/>
            <field name="domain_force">[('manager_ids', 'in', [user.id])]</field>
        </record>

        <record id="rule_food_restaurant_admin" model="ir.rule">
            <field name="name">Administrator: All Restaurants</field>
            <field name="model_id" ref="model_food_restaurant"/>
            <field name="groups" eval="[(4, ref('group_food_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Product Rules -->
        <record id="rule_food_product_manager" model="ir.rule">
            <field name="name">Shop Manager: Assigned Products Only</field>
            <field name="model_id" ref="model_product_template"/>
            <field name="groups" eval="[(4, ref('group_food_shop_manager'))]"/>
            <field name="domain_force">[('food_restaurant_id.manager_ids', 'in', [user.id])]</field>
        </record>

        <record id="rule_food_product_admin" model="ir.rule">
            <field name="name">Administrator: All Products</field>
            <field name="model_id" ref="model_product_template"/>
            <field name="groups" eval="[(4, ref('group_food_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Order Rules -->
        <record id="rule_food_order_manager" model="ir.rule">
            <field name="name">Shop Manager: Assigned Orders Only</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="groups" eval="[(4, ref('group_food_shop_manager'))]"/>
            <field name="domain_force">[('food_restaurant_id.manager_ids', 'in', [user.id])]</field>
        </record>

        <record id="rule_food_order_admin" model="ir.rule">
            <field name="name">Administrator: All Food Orders</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="groups" eval="[(4, ref('group_food_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        
        <!-- Order Line Rules -->
        <record id="rule_food_order_line_manager" model="ir.rule">
            <field name="name">Shop Manager: Assigned Order Lines Only</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="groups" eval="[(4, ref('group_food_shop_manager'))]"/>
            <field name="domain_force">[('order_id.food_restaurant_id.manager_ids', 'in', [user.id])]</field>
        </record>

        <record id="rule_food_order_line_admin" model="ir.rule">
            <field name="name">Administrator: All Food Order Lines</field>
            <field name="model_id" ref="sale.model_sale_order_line"/>
            <field name="groups" eval="[(4, ref('group_food_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        
        <!-- Review Rules -->
        <record id="rule_food_restaurant_review_manager" model="ir.rule">
            <field name="name">Shop Manager: Assigned Reviews Only</field>
            <field name="model_id" ref="model_food_restaurant_review"/>
            <field name="groups" eval="[(4, ref('group_food_shop_manager'))]"/>
            <field name="domain_force">[('restaurant_id.manager_ids', 'in', [user.id])]</field>
        </record>

        <record id="rule_food_restaurant_review_admin" model="ir.rule">
            <field name="name">Administrator: All Reviews</field>
            <field name="model_id" ref="model_food_restaurant_review"/>
            <field name="groups" eval="[(4, ref('group_food_admin'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
