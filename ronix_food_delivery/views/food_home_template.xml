<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="food_home_page" name="Food Home">
            <t t-call="website.layout">
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <t t-set="title">Yemek Sipariş - Hızlı Teslimat</t>
                
                <div id="wrap" class="oe_structure oe_empty food-app-container" t-att-data-google-maps-api-key="google_maps_api_key">
                    
                    <!-- Header -->
                    <div class="fixed-top px-3 py-2 shadow-sm z-index-1030 food-bg-orange-gradient">
                        <div class="d-flex align-items-center gap-2">
                            <div class="flex-grow-1">
                                <button class="btn btn-light rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2 border-0 w-100 text-start" data-bs-toggle="offcanvas" data-bs-target="#addressOffcanvas">
                                    <i class="ri-map-pin-fill food-text-orange" style="font-size:1.125rem;"></i>
                                    <span class="fw-medium text-truncate flex-grow-1 food-text-sm" style="color:#1f2937; max-width:200px;">
                                        <t t-if="current_address">
                                            <t t-out="current_address.name"/>
                                        </t>
                                        <t t-else="">
                                            Adres Seçin
                                        </t>
                                    </span>
                                    <i class="ri-arrow-down-s-line text-secondary"></i>
                                </button>
                            </div>
                            <div class="position-relative">
                                <a href="/food-cart" class="btn rounded-circle d-flex align-items-center justify-content-center border-0 p-0 flex-shrink-0 text-decoration-none" style="width:2.25rem; height:2.25rem; background-color: rgba(255,255,255,0.2);">
                                    <i class="ri-shopping-cart-line text-white" style="font-size:1.125rem;"></i>
                                </a>
                                <span t-attf-class="js-cart-badge position-absolute d-flex align-items-center justify-content-center fw-bold text-white rounded-circle food-text-3xs food-bg-orange shadow-sm #{'d-none' if not order or not sum(order.order_line.filtered(lambda l: l.product_id.is_food).mapped('product_uom_qty')) else ''}" style="top:-0.25rem; right:-0.25rem; width:1rem; height:1rem; pointer-events: none;">
                                    <t t-out="int(sum(order.order_line.filtered(lambda l: l.product_id.is_food).mapped('product_uom_qty')) if order else 0)"/>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Main Padding Space -->
                    <div class="px-3" style="padding-top: 4rem; padding-bottom: 5rem;">
                        
                        <!-- Search Bar -->
                        <div class="pt-2 mb-4 mt-2 position-relative">
                            <div class="position-relative">
                                <input placeholder="Restoran veya yemek ara..." class="food-search-input w-100 js-food-search" type="text" autocomplete="off"/>
                                <i class="ri-search-line position-absolute top-50 translate-middle-y text-secondary" style="left: 1rem; font-size: 1.125rem;"></i>
                            </div>
                            <!-- Search Suggestions Dropdown -->
                            <div class="js-search-results position-absolute w-100 bg-white shadow-lg rounded-4 overflow-hidden d-none" style="top: 100%; left: 0; z-index: 1050; margin-top: 0.5rem;">
                            </div>
                        </div>

                        <!-- Filters slider -->
                        <div class="d-flex gap-2 overflow-auto pb-2 scrollbar-hide mb-4">
                            <a href="/food-popular-foods" class="btn filter-btn-active text-decoration-none">Tümü</a>
                            <a href="/food-popular-foods?order_by=delivery" class="btn filter-btn-inactive text-decoration-none">Hızlı Teslimat</a>
                            <a href="/food-popular-foods?order_by=rating" class="btn filter-btn-inactive text-decoration-none">Yüksek Puan</a>
                            <a href="/food-popular-foods?order_by=price" class="btn filter-btn-inactive text-decoration-none">Uygun Fiyat</a>
                        </div>
                        
                        <!-- Kategoriler Grid -->
                        <div class="mb-4">
                            <h2 class="food-text-base text-dark mb-3 fw-bold" style="font-size: 1.125rem !important;">Kategoriler</h2>
                            <div t-if="not categories" class="text-muted p-3 text-center border rounded-3 bg-white">Henüz kategori bulunamadı.</div>
                            <div class="d-flex gap-2 overflow-auto pb-2 scrollbar-hide flex-nowrap mx-n1 px-1">
                                <t t-foreach="categories" t-as="category">
                                    <div class="flex-shrink-0" style="width: 3.5rem;">
                                        <button class="btn p-0 border-0 bg-transparent w-100 d-flex flex-column align-items-center gap-2 food-category-btn" 
                                                t-attf-onclick="window.location.href='/food-popular-foods?category_id=#{category.id}'">
                                            <div class="food-w-14 food-h-14 d-flex align-items-center justify-content-center overflow-hidden mx-auto p-1 food-rounded-xl bg-white">
                                                <img t-att-alt="category.name" class="w-100 h-100 object-cover" t-attf-src="/web/image?model=product.public.category&amp;id=#{category.id}&amp;field=image_128&amp;format=webp"/>
                                            </div>
                                            <span class="food-text-xs fw-medium text-dark w-100 text-truncate text-center" t-out="category.name"/>
                                        </button>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Favori Restoranlar -->
                        <div class="mb-4" t-if="favorite_restaurants">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 class="food-text-base text-dark mb-0 fw-bold" style="font-size: 1.125rem !important;">Favori Restoranlar</h2>
                                <a href="/food-favorites" class="btn btn-link text-decoration-none food-text-xs fw-medium food-text-orange p-0 border-0" style="box-shadow: none !important; border-radius: 0 !important;">Tümünü Gör</a>
                            </div>
                            <div class="row row-cols-2 g-3">
                                <t t-foreach="favorite_restaurants[:4]" t-as="restaurant">
                                    <div class="col">
                                        <div class="bg-white food-rounded-2xl overflow-hidden shadow active-scale cursor-pointer h-100" t-attf-onclick="window.location.href='/food-restaurant/#{restaurant.id}'">
                                            <div class="position-relative aspect-4x3 overflow-hidden">
                                                <img t-att-alt="restaurant.name" class="w-100 h-100 position-absolute top-0 start-0 object-cover object-top" t-attf-src="/web/image?model=food.restaurant&amp;id=#{restaurant.id}&amp;field=image_512&amp;format=webp" loading="lazy"/>
                                                <button class="btn btn-light position-absolute top-0 end-0 m-2 rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center js-food-toggle-favorite" t-att-data-restaurant-id="restaurant.id" style="width:2rem; height:2rem; z-index:10;" onclick="event.stopPropagation();">
                                                    <i t-attf-class="ri-heart-#{'fill' if request.env.user.id in restaurant.favorite_user_ids.ids else 'line'} text-#{'danger' if request.env.user.id in restaurant.favorite_user_ids.ids else 'secondary'}" style="font-size:1.125rem;"></i>
                                                </button>
                                                <t t-if="restaurant.category_ids">
                                                    <div class="position-absolute bottom-0 start-0 m-2 bg-white px-2 py-1 rounded-pill">
                                                        <span class="food-text-2xs text-dark fw-medium" t-out="restaurant.category_ids[0].name"/>
                                                    </div>
                                                </t>
                                            </div>
                                            <div class="p-3">
                                                <h3 class="fw-semibold text-dark fs-6 mb-2 text-truncate" t-out="restaurant.name"/>
                                                <div class="d-flex align-items-center justify-content-between food-text-2xs text-secondary">
                                                    <div class="d-flex align-items-center gap-1">
                                                        <i class="ri-star-fill text-warning"></i>
                                                        <span class="fw-bold text-dark" t-out="restaurant.rating"/>
                                                        <span class="text-secondary opacity-75">(<t t-out="restaurant.review_count"/>)</span>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-1"><i class="ri-time-line"></i><span><t t-out="restaurant.delivery_time_min"/>-<t t-out="restaurant.delivery_time_max"/> dk</span></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Favori Marketler -->
                        <div class="mb-4" t-if="favorite_groceries">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 class="food-text-base text-dark mb-0 fw-bold" style="font-size: 1.125rem !important;">Favori Marketler</h2>
                                <a href="/food-favorites?is_grocery=True" class="btn btn-link text-decoration-none food-text-xs fw-medium food-text-orange p-0 border-0" style="box-shadow: none !important; border-radius: 0 !important;">Tümünü Gör</a>
                            </div>
                            <div class="d-flex gap-3 overflow-auto pb-2 scrollbar-hide flex-nowrap mx-n3 px-3" style="width: calc(100% + 2rem); margin-left: -1rem;">
                                <t t-foreach="favorite_groceries" t-as="store">
                                    <div class="food-min-w-200">
                                        <div class="bg-white food-rounded-2xl overflow-hidden shadow active-scale cursor-pointer" t-attf-onclick="window.location.href='/food-restaurant/#{store.id}'">
                                            <div class="position-relative food-h-32 overflow-hidden">
                                                <img t-att-alt="store.name" class="w-100 h-100 object-fit-cover object-top" t-attf-src="/web/image?model=food.restaurant&amp;id=#{store.id}&amp;field=image_512&amp;format=webp" loading="lazy"/>
                                                <button class="btn btn-light position-absolute top-0 end-0 m-2 rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center js-food-toggle-favorite" t-att-data-restaurant-id="store.id" style="width:2rem; height:2rem; z-index:10;" onclick="event.stopPropagation();">
                                                    <i t-attf-class="ri-heart-#{'fill' if request.env.user.id in store.favorite_user_ids.ids else 'line'} text-#{'danger' if request.env.user.id in store.favorite_user_ids.ids else 'secondary'}" style="font-size:1.125rem;"></i>
                                                </button>
                                            </div>
                                            <div class="p-3">
                                                <h3 class="fw-semibold text-dark fs-6 mb-2 text-truncate" t-out="store.name"/>
                                                <div class="d-flex align-items-center justify-content-between food-text-2xs text-secondary">
                                                    <div class="d-flex align-items-center gap-1">
                                                        <i class="ri-star-fill text-warning"></i>
                                                        <span class="fw-bold text-dark" t-out="store.rating"/>
                                                        <span class="text-secondary opacity-75">(<t t-out="store.review_count"/>)</span>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-1"><i class="ri-time-line"></i><span><t t-out="store.delivery_time_min"/>-<t t-out="store.delivery_time_max"/> dk</span></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Marketler (Groceries) Slider -->
                        <div class="mb-4" t-if="grocery_stores">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 class="food-text-base text-dark mb-0 fw-bold" style="font-size: 1.125rem !important;">Marketler</h2>
                                <a href="/food-all-restaurants?is_grocery=True" class="btn btn-link text-decoration-none food-text-xs fw-medium food-text-orange p-0 border-0" style="box-shadow: none !important; border-radius: 0 !important;">Tümünü Gör</a>
                            </div>
                            <div class="d-flex gap-3 overflow-auto pb-2 scrollbar-hide flex-nowrap mx-n3 px-3" style="width: calc(100% + 2rem); margin-left: -1rem;">
                                <t t-foreach="grocery_stores" t-as="store">
                                    <div class="food-min-w-200">
                                        <div class="bg-white food-rounded-2xl overflow-hidden shadow active-scale cursor-pointer" t-attf-onclick="window.location.href='/food-restaurant/#{store.id}'">
                                            <div class="position-relative food-h-32 overflow-hidden">
                                                <img t-att-alt="store.name" class="w-100 h-100 object-fit-cover object-top" t-attf-src="/web/image?model=food.restaurant&amp;id=#{store.id}&amp;field=image_512&amp;format=webp" loading="lazy"/>
                                                <button class="btn btn-light position-absolute top-0 end-0 m-2 rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center js-food-toggle-favorite" t-att-data-restaurant-id="store.id" style="width:2rem; height:2rem; z-index:10;" onclick="event.stopPropagation();">
                                                    <i t-attf-class="ri-heart-#{'fill' if request.env.user.id in store.favorite_user_ids.ids else 'line'} text-#{'danger' if request.env.user.id in store.favorite_user_ids.ids else 'secondary'}" style="font-size:1.125rem;"></i>
                                                </button>
                                            </div>
                                            <div class="p-3">
                                                <h3 class="fw-semibold text-dark fs-6 mb-2 text-truncate" t-out="store.name"/>
                                                <div class="d-flex align-items-center justify-content-between food-text-2xs text-secondary">
                                                    <div class="d-flex align-items-center gap-1">
                                                        <i class="ri-star-fill text-warning"></i>
                                                        <span class="fw-bold text-dark" t-out="store.rating"/>
                                                        <span class="text-secondary opacity-75">(<t t-out="store.review_count"/>)</span>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-1"><i class="ri-time-line"></i><span><t t-out="store.delivery_time_min"/>-<t t-out="store.delivery_time_max"/> dk</span></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Popüler Yemekler Slider -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 class="food-text-base text-dark mb-0 fw-bold" style="font-size: 1.125rem !important;">Popüler Yemekler</h2>
                                <a href="/food-popular-foods" class="btn btn-link text-decoration-none food-text-xs fw-medium food-text-orange p-0 border-0" style="box-shadow: none !important; border-radius: 0 !important;">Tümünü Gör</a>
                            </div>
                            <div class="d-flex gap-3 overflow-auto pb-2 scrollbar-hide flex-nowrap mx-n3 px-3" style="width: calc(100% + 2rem); margin-left: -1rem;">
                                <t t-foreach="popular_foods" t-as="food">
                                    <div class="bg-white food-rounded-2xl overflow-hidden shadow food-min-w-140 active-scale cursor-pointer js-open-food-detail" data-bs-toggle="offcanvas" data-bs-target="#foodDetailOffcanvas" t-att-data-food-id="food.id">
                                        <div class="position-relative food-h-28 overflow-hidden">
                                            <img t-att-alt="food.name" class="w-100 h-100 object-fit-cover object-top" t-attf-src="/web/image?model=product.template&amp;id=#{food.id}&amp;field=image_512&amp;format=webp" loading="lazy"/>
                                            <div class="position-absolute w-100 h-100 top-0 start-0 food-gradient-overlay-10"></div>
                                        </div>
                                        <div class="p-3">
                                            <h4 class="fw-bold text-dark food-text-sm mb-1 text-truncate" t-out="food.name"/>
                                            <p class="food-text-2xs text-secondary mb-2 text-truncate fw-medium" t-out="food.food_restaurant_id.name"/>
                                            <div class="d-flex align-items-center justify-content-between">
                                                <span class="food-text-sm fw-bold food-text-orange">$<t t-out="int(food.list_price)"/></span>
                                                <div class="d-flex align-items-center gap-1">
                                                    <i class="ri-star-fill text-warning food-text-xs"></i>
                                                    <span class="food-text-xs text-secondary fw-bold" t-out="food.food_rating"/>
                                                    <span class="food-text-xs text-secondary opacity-75" style="font-size:0.6rem;">(<t t-out="food.food_review_count"/>)</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Tüm Restoranlar Slider -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 class="food-text-base text-dark mb-0 fw-bold" style="font-size: 1.125rem !important;">Tüm Restoranlar</h2>
                                <a href="/food-all-restaurants" class="btn btn-link text-decoration-none food-text-xs fw-medium food-text-orange p-0 border-0" style="box-shadow: none !important; border-radius: 0 !important;">Tümünü Gör</a>
                            </div>
                            <div class="d-flex gap-3 overflow-auto pb-2 scrollbar-hide flex-nowrap mx-n3 px-3" style="width: calc(100% + 2rem); margin-left: -1rem;">
                                <t t-foreach="popular_restaurants" t-as="restaurant">
                                    <div class="food-min-w-200">
                                        <div class="bg-white food-rounded-2xl overflow-hidden shadow active-scale cursor-pointer" t-attf-onclick="window.location.href='/food-restaurant/#{restaurant.id}'">
                                            <div class="position-relative food-h-32 overflow-hidden">
                                                <img t-att-alt="restaurant.name" class="w-100 h-100 object-fit-cover object-top" t-attf-src="/web/image?model=food.restaurant&amp;id=#{restaurant.id}&amp;field=image_512&amp;format=webp" loading="lazy"/>
                                                <button class="btn btn-light position-absolute top-0 end-0 m-2 rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center js-food-toggle-favorite" t-att-data-restaurant-id="restaurant.id" style="width:2rem; height:2rem; z-index:10;" onclick="event.stopPropagation();">
                                                    <i t-attf-class="ri-heart-#{'fill' if request.env.user.id in restaurant.favorite_user_ids.ids else 'line'} text-#{'danger' if request.env.user.id in restaurant.favorite_user_ids.ids else 'secondary'}" style="font-size:1.125rem;"></i>
                                                </button>
                                                <t t-if="restaurant.category_ids">
                                                    <div class="position-absolute bottom-0 start-0 m-2 bg-white px-2 py-1 rounded-pill">
                                                        <span class="food-text-2xs text-dark fw-medium" t-out="restaurant.category_ids[0].name"/>
                                                    </div>
                                                </t>
                                            </div>
                                            <div class="p-3">
                                                <h3 class="fw-semibold text-dark fs-6 mb-2 text-truncate" t-out="restaurant.name"/>
                                                <div class="d-flex align-items-center justify-content-between food-text-2xs text-secondary">
                                                    <div class="d-flex align-items-center gap-1">
                                                        <i class="ri-star-fill text-warning"></i>
                                                        <span class="fw-bold text-dark" t-out="restaurant.rating"/>
                                                        <span class="text-secondary opacity-75">(<t t-out="restaurant.review_count"/>)</span>
                                                    </div>
                                                    <div class="d-flex align-items-center gap-1"><i class="ri-time-line"></i><span><t t-out="restaurant.delivery_time_min"/>-<t t-out="restaurant.delivery_time_max"/> dk</span></div>
                                                    <div class="d-flex align-items-center gap-1"><i class="ri-shopping-bag-line"></i><span>Min $<t t-out="int(restaurant.min_order_amount)"/></span></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Tüm Yemekler Grid -->
                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 class="food-text-base text-dark mb-0 fw-bold" style="font-size: 1.125rem !important;">Tüm Yemekler</h2>
                                <span class="food-text-xs text-secondary"><t t-out="len(all_foods)"/> ürün</span>
                            </div>
                            <div class="row row-cols-2 g-3 pb-4">
                                <t t-foreach="all_foods" t-as="food">
                                    <div class="col">
                                        <div class="bg-white food-rounded-2xl overflow-hidden shadow active-scale cursor-pointer h-100 d-flex flex-column js-open-food-detail" data-bs-toggle="offcanvas" data-bs-target="#foodDetailOffcanvas" t-att-data-food-id="food.id">
                                            <div class="position-relative aspect-4x3 overflow-hidden">
                                                <img t-att-alt="food.name" class="w-100 h-100 position-absolute top-0 start-0 object-cover object-top" t-attf-src="/web/image?model=product.template&amp;id=#{food.id}&amp;field=image_512&amp;format=webp" loading="lazy"/>
                                                <div class="position-absolute w-100 h-100 top-0 start-0 food-gradient-overlay-20"></div>
                                                <t t-if="food.public_categ_ids">
                                                    <div class="position-absolute bottom-0 start-0 m-2 mb-2 food-bg-orange shadow px-2 py-1 rounded-pill">
                                                        <span class="food-text-3xs text-white fw-semibold" t-out="food.public_categ_ids[0].name"/>
                                                    </div>
                                                </t>
                                            </div>
                                            <div class="p-3 d-flex flex-column h-100">
                                                <h4 class="fw-bold text-dark food-text-sm mb-1 text-wrap" t-out="food.name"/>
                                                <p class="food-text-3xs text-secondary mb-2 text-truncate fw-medium" t-out="food.food_restaurant_id.name"/>
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="food-text-sm fw-bold food-text-orange">$<t t-out="int(food.list_price)"/></span>
                                                    <div class="d-flex align-items-center gap-1">
                                                        <i class="ri-star-fill text-warning" style="font-size:0.75rem;"></i>
                                                        <span class="food-text-xs text-secondary fw-bold" t-out="food.food_rating"/>
                                                        <span class="food-text-xs text-secondary opacity-75" style="font-size:0.6rem;">(<t t-out="food.food_review_count"/>)</span>
                                                    </div>
                                                </div>
                                                <button class="btn w-100 py-1 mt-auto food-bg-orange-light food-text-orange food-text-xs fw-medium food-rounded-xl d-flex align-items-center justify-content-center gap-1 shadow-none border-0 active-scale text-nowrap">
                                                    <i class="ri-add-line food-text-sm"></i>Ekle
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom Nav Container (Fixed) -->
                    <div class="fixed-bottom bg-white border-top shadow-sm z-index-1030 pb-2 pb-md-0">
                        <div class="container-fluid px-0">
                            <div class="row text-center align-items-center m-0" style="height: 4rem;">
                                <div class="col px-0">
                                    <a href="/food-home" class="text-decoration-none d-flex flex-column align-items-center justify-content-center h-100">
                                        <i class="ri-compass-3-fill fs-4 food-text-orange mb-0"></i>
                                        <span class="food-text-2xs fw-bold food-text-orange mt-1">Keşfet</span>
                                    </a>
                                </div>
                                <div class="col px-0">
                                    <a href="/food-cart" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                        <i class="ri-shopping-cart-line fs-4 mb-0"></i>
                                        <span class="food-text-2xs fw-bold mt-1">Sepet</span>
                                    </a>
                                </div>
                                <div class="col px-0">
                                    <a href="/food-orders" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                        <i class="ri-file-list-line fs-4 mb-0"></i>
                                        <span class="food-text-2xs fw-bold mt-1">Siparişler</span>
                                    </a>
                                </div>
                                <div class="col px-0">
                                    <a href="/food-profile" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                        <i class="ri-user-line fs-4 mb-0"></i>
                                        <span class="food-text-2xs fw-bold mt-1">Profil</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Offcanvas: Address Selection -->
                    <div class="offcanvas offcanvas-bottom rounded-top-5 border-0" tabindex="-1" id="addressOffcanvas" aria-labelledby="addressOffcanvasLabel" style="height: auto; max-height: 85vh;">
                        <div class="offcanvas-header pb-0 bg-white rounded-top-5 p-4">
                            <h5 class="offcanvas-title fw-bold text-dark fs-5" id="addressOffcanvasLabel">Adres Seç</h5>
                            <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>
                        <div class="offcanvas-body p-4 pt-3 pb-5 bg-white">
                            <div class="d-flex flex-column gap-3 mb-4">
                                <t t-foreach="addresses" t-as="addr">
                                         <div class="d-flex align-items-center justify-content-between bg-light rounded-4 px-3 py-1 mb-2">
                                            <form action="/food/address/select" method="post" class="flex-grow-1 overflow-hidden">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <input type="hidden" name="address_id" t-att-value="addr.id"/>
                                                <button type="submit" t-attf-class="btn w-100 text-start p-3 border-0 active-scale shadow-none #{'food-text-orange' if addr == current_address else 'text-dark'}">
                                                    <div class="d-flex align-items-center gap-3">
                                                        <i t-attf-class="ri-map-pin-fill fs-4 #{'food-text-orange' if addr == current_address else 'text-secondary'}"></i>
                                                        <div class="flex-grow-1 overflow-hidden">
                                                            <div class="fw-bolder food-text-sm">
                                                                <t t-out="addr.name"/>
                                                            </div>
                                                            <div class="text-secondary text-truncate" style="font-size: 0.625rem; max-width: 180px;">
                                                                <t t-out="addr.address_details"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </button>
                                            </form>
                                            <button type="button" class="btn btn-link p-2 text-secondary edit-address-btn shadow-none border-0"
                                                    t-att-data-address-id="addr.id"
                                                    t-att-data-address-name="addr.name"
                                                    t-att-data-address-city="addr.city"
                                                    t-att-data-address-district="addr.district"
                                                    t-att-data-address-details="addr.address_details"
                                                    t-att-data-address-directions="addr.address_directions"
                                                    data-bs-toggle="offcanvas" data-bs-target="#newAddressOffcanvas">
                                                <i class="ri-pencil-line fs-5"></i>
                                            </button>
                                         </div>
                                </t>
                                <t t-if="not addresses">
                                    <div class="text-center py-4">
                                        <i class="ri-map-pin-line fs-1 text-secondary opacity-25"></i>
                                        <p class="text-secondary food-text-sm mt-2">Henüz kayıtlı adresiniz bulunmuyor.</p>
                                    </div>
                                </t>
                            </div>
                                 <button type="button" class="btn food-bg-orange text-white w-100 py-3 rounded-4 fw-bold active-scale shadow-sm add-new-address-btn mt-2" data-bs-toggle="offcanvas" data-bs-target="#newAddressOffcanvas">
                                     Yeni Adres Ekle
                                 </button>
                        </div>
                    </div>

                    <!-- Offcanvas: Food Detail Box Shell (Populated by JS AJAX) -->
                    <div class="offcanvas offcanvas-bottom rounded-top-4 border-0 p-0 overflow-hidden" tabindex="-1" id="foodDetailOffcanvas" aria-labelledby="foodDetailOffcanvasLabel" style="height: auto; max-height: 90vh;">
                        <div class="d-flex justify-content-center align-items-center h-100 w-100 py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    </div>

                    <!-- Offcanvas: New Address -->
                    <div class="offcanvas offcanvas-bottom rounded-top-5 border-0" tabindex="-1" id="newAddressOffcanvas" aria-labelledby="newAddressOffcanvasLabel" style="height: auto; max-height: 90vh;">
                        <div class="offcanvas-header pb-0 bg-white rounded-top-5 p-4 mt-1">
                            <div class="d-flex align-items-center gap-3">
                                <button type="button" class="btn bg-light rounded-circle d-flex align-items-center justify-content-center p-0 border-0" style="width:2.25rem; height:2.25rem;" data-bs-toggle="offcanvas" data-bs-target="#addressOffcanvas">
                                    <i class="ri-arrow-left-line text-dark fs-5"></i>
                                </button>
                                <h5 class="offcanvas-title fw-bold text-dark fs-5 mb-0" id="newAddressOffcanvasLabel">Yeni Adres Ekle</h5>
                            </div>
                            <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                        </div>
                        <div class="offcanvas-body p-4 pt-4 pb-5 bg-white">
                            <form action="/food/address/add" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="d-flex flex-column gap-3 mb-2">
                                    <div>
                                        <input name="address_title" required="required" placeholder="Adres Başlığı (Ev, İş vb.)" class="food-search-input w-100 py-3 rounded-4" type="text" style="padding-left: 1.25rem;"/>
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <input name="city" placeholder="İl" class="food-search-input w-100 py-3 rounded-4" type="text" style="padding-left: 1.25rem;"/>
                                        </div>
                                        <div class="col-6">
                                            <input name="district" placeholder="İlçe" class="food-search-input w-100 py-3 rounded-4" type="text" style="padding-left: 1.25rem;"/>
                                        </div>
                                    </div>
                                    <div>
                                        <textarea name="address_details" required="required" placeholder="Açık Adres (Mahalle, Sokak, Bina No, Daire No)" rows="3" class="food-search-input w-100 py-3 rounded-4 h-auto" style="padding-left: 1.25rem;"></textarea>
                                    </div>
                                    <div>
                                        <input name="address_directions" placeholder="Adres Tarifi (İsteğe bağlı)" class="food-search-input w-100 py-3 rounded-4" type="text" style="padding-left: 1.25rem;"/>
                                    </div>
                                    <button type="submit" class="btn w-100 food-bg-orange text-white py-3 rounded-4 fw-bold active-scale shadow-sm mt-2">
                                        Adresi Kaydet
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <t t-call="ronix_food_delivery.food_common_modals"/>

                </div>
            </t>
        </template>
    </data>
</odoo>
