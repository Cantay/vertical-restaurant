<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_food" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.food</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='name']" position="after">
                <field name="food_addons_summary" string="Yemek Ekstraları" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//form//field[@name='name']" position="after">
                <group string="Yemek Detayları" invisible="not product_id">
                    <field name="food_notes"/>
                    <field name="food_line_addon_ids">
                        <list editable="bottom">
                            <field name="addon_id"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="price_total"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
