<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_food_review_tag_tree" model="ir.ui.view">
            <field name="name">food.review.tag.tree</field>
            <field name="model">food.review.tag</field>
            <field name="arch" type="xml">
                <list string="Review Tags" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="icon"/>
                    <field name="category"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="action_food_review_tag" model="ir.actions.act_window">
            <field name="name">Review Tags</field>
            <field name="res_model">food.review.tag</field>
            <field name="view_mode">list</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new review tag!
                </p>
            </field>
        </record>

        <menuitem id="menu_food_review_tag"
                  name="Değerlendirme Etiketleri"
                  parent="ronix_food_delivery.menu_food_delivery_settings"
                  action="action_food_review_tag"
                  groups="ronix_food_delivery.group_food_admin"
                  sequence="20"/>
    </data>
</odoo>
