<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="food_popular_foods_page" name="Food Popular Foods">
            <t t-call="website.layout">
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <t t-set="title">Tüm Yemekler</t>
                
                <style>
                    .food-search-placeholder-white::placeholder {
                        color: rgba(255, 255, 255, 0.8) !important;
                    }
                    .food-search-placeholder-white {
                        color: white !important;
                    }
                    .food-rounded-3xl {
                        border-radius: 1.5rem !important;
                    }
                    .food-rounded-top-3xl {
                        border-top-left-radius: 1.5rem !important;
                        border-top-right-radius: 1.5rem !important;
                    }
                </style>

                <div id="wrap" class="oe_structure oe_empty bg-light min-vh-100 pb-5 mb-5 food-app-container">
                    
                    <!-- Header -->
                    <div class="fixed-top z-index-1030 food-bg-orange-gradient shadow-md">
                        <div class="flex items-center px-4 py-3 gap-3 d-flex align-items-center">
                            <a href="/food-home" class="btn p-0 border-0 bg-white/20 rounded-circle text-white d-flex align-items-center justify-content-center shrink-0" style="width:2.5rem; height:2.5rem; background-color: rgba(255,255,255,0.2);">
                                <i class="ri-arrow-left-line fs-5"></i>
                            </a>
                            <h1 class="text-base font-bold text-white flex-grow-1 h6 mb-0">Tüm Yemekler</h1>
                            <span class="text-xs text-white-50 font-medium" style="font-size: 0.75rem;"><t t-out="len(popular_foods)"/> ürün</span>
                        </div>
                        <div class="px-4 pb-3">
                            <form action="/food-popular-foods" method="get" class="position-relative">
                                <div class="d-flex align-items-center bg-white/20 rounded-pill px-3 py-2 gap-2" style="background-color: rgba(255,255,255,0.2);">
                                    <i class="ri-search-line text-white/80 text-white-50"></i>
                                    <input name="q" t-att-value="q" placeholder="Yemek veya restoran ara..." class="flex-grow-1 bg-transparent border-0 text-white food-search-placeholder-white text-sm outline-none food-text-sm js-food-search" type="text" style="box-shadow: none;" autocomplete="off"/>
                                </div>
                                <input t-if="active_category_id" type="hidden" name="category_id" t-att-value="active_category_id"/>
                                <input t-if="active_order_by" type="hidden" name="order_by" t-att-value="active_order_by"/>
                                <!-- Search Suggestions Dropdown -->
                                <div class="js-search-results position-absolute w-100 bg-white shadow-lg rounded-4 overflow-hidden d-none" style="top: 100%; left: 0; z-index: 1050; margin-top: 0.5rem;">
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Main Content -->
                    <div class="px-3" style="padding-top: 9.5rem; padding-bottom: 5.5rem;">
                        
                        <!-- Categories Scroll -->
                        <div class="d-flex gap-2 overflow-auto pb-1 mb-3 no-scrollbar" style="scrollbar-width: none;">
                            <a t-attf-href="/food-popular-foods?#{'order_by=' + active_order_by if active_order_by else ''}#{'&amp;q=' + q if q else ''}" 
                               t-attf-class="btn btn-sm rounded-pill whitespace-nowrap food-text-xs fw-bold px-4 py-2 shadow-sm border-0 #{'food-bg-orange text-white' if not active_category_id else 'bg-white text-dark'}">Tümü</a>
                            <t t-foreach="categories" t-as="category">
                                <a t-attf-href="/food-popular-foods?category_id=#{category.id}#{'&amp;order_by=' + active_order_by if active_order_by else ''}#{'&amp;q=' + q if q else ''}" 
                                   t-attf-class="btn btn-sm rounded-pill whitespace-nowrap food-text-xs fw-bold px-4 py-2 shadow-sm border-0 #{'food-bg-orange text-white' if active_category_id == category.id else 'bg-white text-dark'}">
                                    <t t-out="category.name"/>
                                </a>
                            </t>
                        </div>

                        <!-- Filters Scroll -->
                        <div class="d-flex gap-2 overflow-auto pb-1 mb-4 no-scrollbar" style="scrollbar-width: none;">
                            <a t-attf-href="/food-popular-foods?order_by=rating#{'&amp;category_id=' + str(active_category_id) if active_category_id else ''}#{'&amp;q=' + q if q else ''}" 
                               t-attf-class="btn btn-sm rounded-pill whitespace-nowrap food-text-2xs fw-bold px-3 py-1-5 d-flex align-items-center gap-1 border #{'food-border-orange food-bg-orange-light food-text-orange' if active_order_by == 'rating' or not active_order_by else 'bg-white text-secondary'}">
                                <i t-if="active_order_by == 'rating' or not active_order_by" class="ri-check-line"></i>Önerilen
                            </a>
                            <a t-attf-href="/food-popular-foods?order_by=delivery#{'&amp;category_id=' + str(active_category_id) if active_category_id else ''}#{'&amp;q=' + q if q else ''}" 
                               t-attf-class="btn btn-sm rounded-pill whitespace-nowrap food-text-2xs fw-bold px-3 py-1-5 d-flex align-items-center gap-1 border #{'food-border-orange food-bg-orange-light food-text-orange' if active_order_by == 'delivery' else 'bg-white text-secondary'}">
                                <i t-if="active_order_by == 'delivery'" class="ri-check-line"></i>En Hızlı
                            </a>
                            <a t-attf-href="/food-popular-foods?order_by=price#{'&amp;category_id=' + str(active_category_id) if active_category_id else ''}#{'&amp;q=' + q if q else ''}" 
                               t-attf-class="btn btn-sm rounded-pill whitespace-nowrap food-text-2xs fw-bold px-3 py-1-5 d-flex align-items-center gap-1 border #{'food-border-orange food-bg-orange-light food-text-orange' if active_order_by == 'price' else 'bg-white text-secondary'}">
                                <i t-if="active_order_by == 'price'" class="ri-check-line"></i>En Uygun
                            </a>
                        </div>

                        <!-- Food Grid -->
                        <div class="row g-3">
                            <t t-foreach="popular_foods" t-as="food">
                                <!-- Food Card -->
                                <div class="col-6">
                                    <div class="bg-white food-rounded-3xl overflow-hidden shadow-sm active-scale cursor-pointer h-100 d-flex flex-column js-open-food-detail" data-bs-toggle="offcanvas" data-bs-target="#foodDetailOffcanvas" t-att-data-food-id="food.id">
                                        <div class="position-relative" style="height: 9rem;">
                                            <img t-attf-src="/web/image?model=product.template&amp;id=#{food.id}&amp;field=image_512&amp;format=webp" t-att-alt="food.name" class="w-100 h-100 border-0 food-rounded-top-3xl" style="object-fit: cover; object-position: center;" loading="lazy"/>
                                            <div t-if="food.public_categ_ids" class="position-absolute bottom-0 start-0 m-2 px-2 py-0-5 rounded-pill shadow-sm" style="background-color: rgba(255, 126, 0, 0.9) !important;">
                                                <span class="food-text-3xs fw-bold text-white"><t t-out="food.public_categ_ids[0].name"/></span>
                                            </div>
                                        </div>
                                        <div class="p-3 flex-grow-1 d-flex flex-column">
                                            <h4 class="food-text-sm fw-bold text-dark mb-0 text-truncate" t-out="food.name"/>
                                            <p class="food-text-3xs text-muted mb-3 text-truncate" t-out="food.food_restaurant_id.name"/>
                                            <div class="mt-auto">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="food-text-base fw-bold food-text-orange">$<t t-out="int(food.list_price)"/></span>
                                                    <div class="d-flex align-items-center gap-1 food-text-xs">
                                                        <i class="ri-star-fill text-warning"></i>
                                                        <span class="text-dark fw-bold" t-out="food.food_rating"/>
                                                    </div>
                                                </div>
                                                <button class="btn w-100 py-2 food-text-xs fw-bold rounded-pill border-0 d-flex align-items-center justify-content-center gap-1 active-scale transition-all" style="background-color: #fff7ed; color: #ff7e00;">
                                                    <i class="ri-add-line fs-5"></i>Ekle
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                    </div>
                    
                    <!-- Offcanvas: Food Detail Box Shell (Populated by JS AJAX) -->
                    <div class="offcanvas offcanvas-bottom rounded-top-4 border-0 p-0 overflow-hidden" tabindex="-1" id="foodDetailOffcanvas" aria-labelledby="foodDetailOffcanvasLabel" style="height: auto; max-height: 90vh;">
                        <div class="d-flex justify-content-center align-items-center h-100 w-100 py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    </div>

                    <!-- Bottom Nav -->
                    <div class="fixed-bottom bg-white border-top border-gray-200 z-index-1030 h-auto">
                        <div class="row row-cols-4 g-0 text-center" style="height:4.5rem;">
                            <div class="col">
                                <a href="/food-home" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                    <i class="ri-compass-3-line fs-3 mb-0"></i>
                                    <span class="food-text-3xs mt-1">Keşfet</span>
                                </a>
                            </div>
                            <div class="col">
                                <a href="/food-cart" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                    <i class="ri-shopping-cart-line fs-3 mb-0"></i>
                                    <span t-attf-class="js-cart-badge position-absolute d-flex align-items-center justify-content-center fw-bold text-white rounded-circle food-text-3xs food-bg-orange shadow-sm #{'d-none' if not order or not sum(order.order_line.filtered(lambda l: l.product_id.is_food).mapped('product_uom_qty')) else ''}" style="top:-0.2rem; right:-0.2rem; width:1.125rem; height:1.125rem;">
                                        <t t-out="int(sum(order.order_line.filtered(lambda l: l.product_id.is_food).mapped('product_uom_qty')) if order else 0)"/>
                                    </span>
                                    <span class="food-text-3xs mt-1">Sepet</span>
                                </a>
                            </div>
                            <div class="col">
                                <a href="/food-orders" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                    <i class="ri-file-list-line fs-3 mb-0"></i>
                                    <span class="food-text-3xs mt-1">Siparişler</span>
                                </a>
                            </div>
                            <div class="col">
                                <a href="/food-profile" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                    <i class="ri-user-line fs-3 mb-0"></i>
                                    <span class="food-text-3xs mt-1">Profil</span>
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </t>
        </template>
    </data>
</odoo>
