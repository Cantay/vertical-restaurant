<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="food_favorites_page" name="Food Favorites">
            <t t-call="website.layout">
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <t t-set="title">Favorilerim</t>

                <!-- Need food app specific custom classes -->
                <div id="wrap" class="oe_structure oe_empty food-app-container bg-light min-vh-100 pb-5 mb-5">
                    
                    <!-- Header -->
                    <div class="fixed-top px-3 pt-3 pb-3 shadow-sm z-index-1030 food-bg-orange-gradient text-white">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <a href="javascript:history.back()" class="btn btn-link p-0 text-white text-decoration-none d-flex align-items-center justify-content-center flex-shrink-0 rounded-circle" style="width:2.25rem; height:2.25rem; background-color: rgba(255,255,255,0.2);">
                                <i class="ri-arrow-left-line fs-5"></i>
                            </a>
                            <h1 class="h6 fw-bold mb-0 flex-grow-1 text-truncate">Favorilerim</h1>
                        </div>
                        
                        <!-- Tabs -->
                        <div class="d-flex gap-2 rounded-pill p-1" style="background-color: rgba(255,255,255,0.2);">
                            <button class="btn flex-grow-1 py-1 food-text-sm fw-medium rounded-pill border-0 shadow-sm bg-white food-text-orange">
                                Restoranlar
                            </button>
                            <button class="btn flex-grow-1 py-1 food-text-sm fw-medium rounded-pill border-0 text-white shadow-none">
                                Yemekler
                            </button>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="px-3" style="padding-top: 8rem; padding-bottom: 5rem;">
                        <div class="d-flex flex-column gap-3">
                            
                            <!-- Favorite Res 1 -->
                            <div class="bg-white rounded-4 overflow-hidden shadow-sm border">
                                <div class="position-relative" style="height: 8rem;">
                                    <img alt="Pizza House" class="w-100 h-100 object-fit-cover" src="https://public.readdy.ai/ai/img_res/5b12c39239693d32d5a5677cc49af8ad.jpg"/>
                                    <button class="btn btn-light position-absolute top-0 end-0 m-2 rounded-circle p-0 d-flex align-items-center justify-content-center shadow-sm" style="width:2rem; height:2rem;">
                                        <i class="ri-heart-fill text-danger text-lg"></i>
                                    </button>
                                </div>
                                <div class="p-3">
                                    <h3 class="fw-bolder text-dark text-truncate mb-1" style="font-size:0.875rem;">Pizza House</h3>
                                    <div class="d-flex align-items-center gap-3 text-secondary mb-2" style="font-size:0.75rem;">
                                        <span class="d-flex align-items-center gap-1">
                                            <i class="ri-star-fill text-warning"></i>4.8
                                        </span>
                                        <span>İtalyan</span>
                                        <span>20-30 dk</span>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="text-secondary" style="font-size:0.75rem;">Min. 50 TL</span>
                                        <button class="btn food-bg-orange text-white fw-medium rounded-pill px-3 py-1" style="font-size:0.75rem;">Sipariş Ver</button>
                                    </div>
                                </div>
                            </div>

                            <!-- Favorite Res 2 -->
                            <div class="bg-white rounded-4 overflow-hidden shadow-sm border">
                                <div class="position-relative" style="height: 8rem;">
                                    <img alt="Kebap Evi" class="w-100 h-100 object-fit-cover" src="https://readdy.ai/api/search-image?query=Traditional%20Turkish%20kebab%20restaurant%20exterior%2C%20authentic%20Ottoman%20style%20architecture%2C%20red%20and%20gold%20colors%2C%20hanging%20lanterns%2C%20wooden%20details%2C%20warm%20inviting%20atmosphere%2C%20professional%20photography%2C%20realistic%20style%2C%20centered%20composition%2C%20high%20quality&amp;width=400&amp;height=300&amp;seq=fav-rest-2&amp;orientation=landscape"/>
                                    <button class="btn btn-light position-absolute top-0 end-0 m-2 rounded-circle p-0 d-flex align-items-center justify-content-center shadow-sm" style="width:2rem; height:2rem;">
                                        <i class="ri-heart-fill text-danger text-lg"></i>
                                    </button>
                                </div>
                                <div class="p-3">
                                    <h3 class="fw-bolder text-dark text-truncate mb-1" style="font-size:0.875rem;">Kebap Evi</h3>
                                    <div class="d-flex align-items-center gap-3 text-secondary mb-2" style="font-size:0.75rem;">
                                        <span class="d-flex align-items-center gap-1">
                                            <i class="ri-star-fill text-warning"></i>4.9
                                        </span>
                                        <span>Türk Mutfağı</span>
                                        <span>25-35 dk</span>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="text-secondary" style="font-size:0.75rem;">Min. 60 TL</span>
                                        <button class="btn food-bg-orange text-white fw-medium rounded-pill px-3 py-1" style="font-size:0.75rem;">Sipariş Ver</button>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Favorite Res 3 -->
                            <div class="bg-white rounded-4 overflow-hidden shadow-sm border">
                                <div class="position-relative" style="height: 8rem;">
                                    <img alt="Tatlı Dünyası" class="w-100 h-100 object-fit-cover" src="https://readdy.ai/api/search-image?query=Elegant%20Turkish%20dessert%20shop%20storefront%2C%20display%20window%20full%20of%20baklava%20and%20Turkish%20sweets%2C%20pastel%20pink%20and%20gold%20colors%2C%20modern%20minimalist%20design%2C%20soft%20lighting%2C%20professional%20food%20photography%2C%20inviting%20atmosphere%2C%20realistic%20style%2C%20centered%20composition&amp;width=400&amp;height=300&amp;seq=fav-rest-3&amp;orientation=landscape"/>
                                    <button class="btn btn-light position-absolute top-0 end-0 m-2 rounded-circle p-0 d-flex align-items-center justify-content-center shadow-sm" style="width:2rem; height:2rem;">
                                        <i class="ri-heart-fill text-danger text-lg"></i>
                                    </button>
                                </div>
                                <div class="p-3">
                                    <h3 class="fw-bolder text-dark text-truncate mb-1" style="font-size:0.875rem;">Tatlı Dünyası</h3>
                                    <div class="d-flex align-items-center gap-3 text-secondary mb-2" style="font-size:0.75rem;">
                                        <span class="d-flex align-items-center gap-1">
                                            <i class="ri-star-fill text-warning"></i>4.7
                                        </span>
                                        <span>Tatlı &amp; Pasta</span>
                                        <span>15-25 dk</span>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="text-secondary" style="font-size:0.75rem;">Min. 40 TL</span>
                                        <button class="btn food-bg-orange text-white fw-medium rounded-pill px-3 py-1" style="font-size:0.75rem;">Sipariş Ver</button>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                    </div>

                    <!-- Bottom Nav Container (Fixed) -->
                    <div class="fixed-bottom bg-white border-top shadow-sm z-index-1030 pb-2 pb-md-0">
                        <div class="container-fluid px-0">
                            <div class="row text-center align-items-center m-0" style="height: 4rem;">
                                <div class="col px-0">
                                    <a href="/food-home" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                        <i class="ri-compass-3-line fs-4 mb-0"></i>
                                        <span class="food-text-2xs mt-1">Keşfet</span>
                                    </a>
                                </div>
                                <div class="col px-0">
                                    <a href="/food-cart" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                        <i class="ri-shopping-cart-line fs-4 mb-0"></i>
                                        <span class="food-text-2xs mt-1">Sepet</span>
                                    </a>
                                </div>
                                <div class="col px-0">
                                    <a href="/food-orders" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                        <i class="ri-file-list-line fs-4 mb-0"></i>
                                        <span class="food-text-2xs mt-1">Siparişler</span>
                                    </a>
                                </div>
                                <div class="col px-0">
                                    <a href="/food-profile" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                        <i class="ri-user-line fs-4 mb-0"></i>
                                        <span class="food-text-2xs mt-1">Profil</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </t>
        </template>
    </data>
</odoo>
