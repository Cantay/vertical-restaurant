<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="food_support_page" name="Food Support">
            <t t-call="website.layout">
                <t t-set="no_header" t-value="True"/>
                <t t-set="no_footer" t-value="True"/>
                <t t-set="title">Yardım &amp; Destek</t>

                <!-- Need food app specific custom classes -->
                <div id="wrap" class="oe_structure oe_empty food-app-container bg-light min-vh-100 pb-5 mb-5">
                    
                    <!-- Header -->
                    <div class="fixed-top px-3 pt-3 pb-3 shadow-sm z-index-1030 food-bg-orange-gradient text-white">
                        <div class="d-flex align-items-center gap-3">
                            <a href="/food-profile" class="btn btn-link p-0 text-white text-decoration-none d-flex align-items-center justify-content-center flex-shrink-0" style="width:2.25rem; height:2.25rem;">
                                <i class="ri-arrow-left-line fs-5"></i>
                            </a>
                            <h1 class="h6 fw-bold mb-0 flex-grow-1 text-truncate">Yardım &amp; Destek</h1>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="px-3" style="padding-top: 5rem; padding-bottom: 5rem;">
                        <div class="d-flex flex-column gap-3">
                            
                            <!-- Contact Buttons -->
                            <div class="row g-2">
                                <div class="col-6">
                                    <a href="tel:+17206962442" class="btn bg-white w-100 rounded-4 p-3 shadow-sm border d-flex flex-column align-items-center justify-content-center gap-2 text-decoration-none">
                                        <div class="d-flex align-items-center justify-content-center bg-success-subtle rounded-circle" style="width:3rem; height:3rem;">
                                            <i class="ri-phone-line text-success fs-3"></i>
                                        </div>
                                        <span class="text-dark fw-medium" style="font-size:0.75rem;">Telefonla Ara</span>
                                    </a>
                                </div>
                                <div class="col-6">
                                    <a href="/destek-merkezi" class="btn bg-white w-100 rounded-4 p-3 shadow-sm border d-flex flex-column align-items-center justify-content-center gap-2 text-decoration-none">
                                        <div class="d-flex align-items-center justify-content-center bg-primary-subtle rounded-circle" style="width:3rem; height:3rem;">
                                            <i class="ri-customer-service-line text-primary fs-3"></i>
                                        </div>
                                        <span class="text-dark fw-medium" style="font-size:0.75rem;">Canlı Destek</span>
                                    </a>
                                </div>
                            </div>
                            
                            <!-- FAQ Accordion -->
                            <div class="bg-white rounded-4 p-3 shadow-sm border">
                                <h3 class="food-text-sm fw-bolder text-dark mb-3">Sıkça Sorulan Sorular</h3>
                                <div class="accordion accordion-flush food-faq-accordion" id="faqAccordion">
                                    
                                    <!-- FAQ Item 1 -->
                                    <div class="accordion-item border-bottom border-light-subtle">
                                        <h2 class="accordion-header" id="faqHeading1">
                                            <button class="accordion-button collapsed px-0 text-dark fw-medium bg-transparent shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse1" aria-expanded="false" aria-controls="faqCollapse1" style="font-size:0.875rem;">
                                                Sipariş takibi nasıl yapılır?
                                            </button>
                                        </h2>
                                        <div id="faqCollapse1" class="accordion-collapse collapse" aria-labelledby="faqHeading1" data-bs-parent="#faqAccordion">
                                            <div class="accordion-body px-0 pt-0 pb-3 text-secondary" style="font-size:0.875rem;">
                                                Siparişlerim sayfasından aktif siparişinize tıklayarak detayları görebilir ve anlık olarak siparişinizin durumunu takip edebilirsiniz. Kurye bilgilerine de buradan ulaşabilirsiniz.
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- FAQ Item 2 -->
                                    <div class="accordion-item border-bottom border-light-subtle">
                                        <h2 class="accordion-header" id="faqHeading2">
                                            <button class="accordion-button collapsed px-0 text-dark fw-medium bg-transparent shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse2" aria-expanded="false" aria-controls="faqCollapse2" style="font-size:0.875rem;">
                                                Minimum sipariş tutarı var mı?
                                            </button>
                                        </h2>
                                        <div id="faqCollapse2" class="accordion-collapse collapse" aria-labelledby="faqHeading2" data-bs-parent="#faqAccordion">
                                            <div class="accordion-body px-0 pt-0 pb-3 text-secondary" style="font-size:0.875rem;">
                                                Evet, her restoranın kendi belirlediği minimum sipariş tutarı bulunmaktadır. Restoran detay sayfasında bu tutarı görebilirsiniz.
                                            </div>
                                        </div>
                                    </div>

                                    <!-- FAQ Item 3 -->
                                    <div class="accordion-item border-bottom border-light-subtle">
                                        <h2 class="accordion-header" id="faqHeading3">
                                            <button class="accordion-button collapsed px-0 text-dark fw-medium bg-transparent shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse3" aria-expanded="false" aria-controls="faqCollapse3" style="font-size:0.875rem;">
                                                Teslimat ücreti ne kadar?
                                            </button>
                                        </h2>
                                        <div id="faqCollapse3" class="accordion-collapse collapse" aria-labelledby="faqHeading3" data-bs-parent="#faqAccordion">
                                            <div class="accordion-body px-0 pt-0 pb-3 text-secondary" style="font-size:0.875rem;">
                                                Teslimat ücreti restoranın uzaklığına göre değişkenlik gösterebilir veya bazı restoranlarda ücretsiz olabilir.
                                            </div>
                                        </div>
                                    </div>
                                    
                                </div>
                            </div>
                            

                            <!-- Contact Info -->
                            <div class="bg-white rounded-4 p-3 shadow-sm border">
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="d-flex align-items-center justify-content-center food-bg-orange-light rounded-circle" style="width:2.5rem; height:2.5rem;">
                                        <i class="ri-information-line food-text-orange" style="font-size:1.125rem;"></i>
                                    </div>
                                    <p class="food-text-sm fw-medium text-dark mb-0">İletişim Bilgileri</p>
                                </div>
                                <div class="ps-5 text-secondary" style="font-size:0.75rem;">
                                    <p class="mb-1">E-posta: <a href="mailto:info@odinrideshare.com" class="text-decoration-none text-secondary">info@odinrideshare.com</a></p>
                                    <p class="mb-1">Telefon: <a href="tel:+17206962442" class="text-decoration-none text-secondary">+1 (720) 696-2442</a></p>
                                    <p class="mb-0">Çalışma Saatleri: 7/24</p>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Bottom Nav Container (Fixed) -->
                    <div class="fixed-bottom bg-white border-top shadow-sm z-index-1030 pb-2 pb-md-0">
                        <div class="container-fluid px-0">
                            <div class="row text-center align-items-center m-0" style="height: 4rem;">
                                <div class="col px-0">
                                    <a href="/food-home" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                        <i class="ri-compass-3-line fs-4 mb-0"></i>
                                        <span class="food-text-2xs mt-1">Keşfet</span>
                                    </a>
                                </div>
                                <div class="col px-0">
                                    <a href="/food-cart" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                        <i class="ri-shopping-cart-line fs-4 mb-0"></i>
                                        <span class="food-text-2xs mt-1">Sepet</span>
                                    </a>
                                </div>
                                <div class="col px-0">
                                    <a href="/food-orders" class="text-decoration-none d-flex flex-column align-items-center justify-content-center text-muted h-100">
                                        <i class="ri-file-list-line fs-4 mb-0"></i>
                                        <span class="food-text-2xs mt-1">Siparişler</span>
                                    </a>
                                </div>
                                <div class="col px-0">
                                    <a href="/food-profile" class="text-decoration-none d-flex flex-column align-items-center justify-content-center h-100">
                                        <i class="ri-user-fill fs-4 food-text-orange mb-0"></i>
                                        <span class="food-text-2xs fw-bold food-text-orange mt-1">Profil</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </t>
        </template>
    </data>
</odoo>
