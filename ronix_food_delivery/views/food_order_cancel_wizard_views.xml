<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_food_order_cancel_wizard_form" model="ir.ui.view">
        <field name="name">food.order.cancel.wizard.form</field>
        <field name="model">food.order.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Siparis Iptal">
                <sheet>
                    <group>
                        <field name="order_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="cancel_reason"
                               widget="text"
                               colspan="2"
                               nolabel="1"
                               placeholder="Iptal sebebini yazin..."
                               style="min-height: 140px; width: 100%;"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_cancel" string="Iptal Et ve Iade Yap" type="object" class="btn-primary"/>
                    <button string="Vazgec" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
