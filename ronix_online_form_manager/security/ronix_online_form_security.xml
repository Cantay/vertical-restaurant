<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ronix_online_form_manager" model="ir.module.category">
        <field name="name">Ronix Cevrimici Form Yonetimi</field>
        <field name="sequence">36</field>
    </record>

    <record id="group_ronix_online_form_user" model="res.groups">
        <field name="name">Kullanici</field>
        <field name="category_id" ref="ronix_online_form_manager.module_category_ronix_online_form_manager"/>
