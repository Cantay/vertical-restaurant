<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ronix_quality_training_list" model="ir.ui.view">
        <field name="name">ronix.quality.training.list</field>
        <field name="model">ronix.quality.training</field>
        <field name="arch" type="xml">
            <list string="Egitimler" default_order="publish_date desc, sequence asc, id desc">
                <field name="sequence" widget="handle"/>
                <field name="location_id" optional="show"/>
                <field name="publish_date"/>
                <field name="name"/>
                <field name="attachment_count"/>
                <field name="website_published"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ronix_quality_training_form" model="ir.ui.view">
        <field name="name">ronix.quality.training.form</field>
        <field name="model">ronix.quality.training</field>
        <field name="arch" type="xml">
            <form string="Egitim">
                <header>
                    <button name="action_open_website_page"
                            string="Web Sitesinde Ac"
                            type="object"
                            class="btn btn-secondary"/>
                    <field name="website_published" widget="boolean_toggle"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="location_id"/>
                            <field name="name"/>
                            <field name="publish_date"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="attachment_count" readonly="1"/>
                            <field name="website_url" widget="url" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Icerik">
                            <field name="body" widget="html"/>
                        </page>
                        <page string="Ekler">
                            <field name="attachment_ids" context="{'default_training_id': id}" mode="list,form">
                                <list editable="bottom" default_order="sequence asc, id asc">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="datas" filename="datas_fname" widget="binary"/>
                                    <field name="datas_fname"/>
                                </list>
                                <form string="Ek">
                                    <group>
                                        <group>
                                            <field name="sequence"/>
                                            <field name="name"/>
                                        </group>
                                        <group>
                                            <field name="datas" filename="datas_fname" widget="binary"/>
                                            <field name="datas_fname"/>
                                            <field name="download_url" widget="url" readonly="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ronix_quality_training_search" model="ir.ui.view">
        <field name="name">ronix.quality.training.search</field>
        <field name="model">ronix.quality.training</field>
        <field name="arch" type="xml">
            <search string="Egitimler">
                <field name="location_id"/>
                <field name="name"/>
                <field name="publish_date"/>
                <filter string="Lokasyon" name="group_location_id" context="{'group_by': 'location_id'}"/>
                <filter string="Website'de Acik" name="website_published" domain="[('website_published', '=', True)]"/>
                <filter string="Aktif" name="active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_ronix_quality_training" model="ir.actions.act_window">
        <field name="name">Egitimler</field>
        <field name="res_model">ronix.quality.training</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ronix_quality_training_search"/>
        <field name="groups_id" eval="[(6, 0, [
            ref('ronix_quality_manager.group_ronix_quality_user'),
            ref('ronix_quality_manager.group_ronix_quality_manager'),
            ref('ronix_quality_manager.group_ronix_quality_admin'),
        ])]"/>
    </record>
</odoo>
