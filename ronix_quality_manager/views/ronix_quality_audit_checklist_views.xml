<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ronix_quality_audit_group_list" model="ir.ui.view">
        <field name="name">ronix.quality.audit.group.list</field>
        <field name="model">ronix.quality.audit.group</field>
        <field name="arch" type="xml">
            <list string="Denetime Hazır Mıyım?" default_order="sequence asc, id asc">
                <field name="sequence" widget="handle"/>
                <field name="location_id" optional="show"/>
                <field name="department_name"/>
                <field name="item_count"/>
                <field name="website_published"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ronix_quality_audit_group_form" model="ir.ui.view">
        <field name="name">ronix.quality.audit.group.form</field>
        <field name="model">ronix.quality.audit.group</field>
        <field name="arch" type="xml">
            <form string="Denetime Hazır Mıyım? Departmanı">
                <header>
                    <button name="action_open_website_page"
                            string="Website'de Ac"
                            type="object"
                            class="btn btn-secondary"/>
                    <field name="website_published" widget="boolean_toggle"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="location_id"/>
                            <field name="department_name"/>
                            <field name="sequence"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="item_count" readonly="1"/>
                            <field name="website_url" widget="url" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Yapılacaklar">
                            <field name="item_ids" context="{'default_group_id': id}" mode="list,form">
                                <list editable="bottom" default_order="sequence asc, id asc">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="note"/>
                                    <field name="active"/>
                                </list>
                                <form string="Yapılacak">
                                    <group>
                                        <group>
                                            <field name="sequence"/>
                                            <field name="name"/>
                                        </group>
                                        <group>
                                            <field name="note"/>
                                            <field name="active"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ronix_quality_audit_group_search" model="ir.ui.view">
        <field name="name">ronix.quality.audit.group.search</field>
        <field name="model">ronix.quality.audit.group</field>
        <field name="arch" type="xml">
            <search string="Denetime Hazır Mıyım?">
                <field name="location_id"/>
                <field name="department_name"/>
                <filter string="Lokasyon" name="group_location_id" context="{'group_by': 'location_id'}"/>
                <filter string="Website'de Acik" name="website_published" domain="[('website_published', '=', True)]"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_ronix_quality_audit_group" model="ir.actions.act_window">
        <field name="name">Denetime Hazır Mıyım?</field>
        <field name="res_model">ronix.quality.audit.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ronix_quality_audit_group_search"/>
        <field name="groups_id" eval="[(6, 0, [
            ref('ronix_quality_manager.group_ronix_quality_user'),
            ref('ronix_quality_manager.group_ronix_quality_manager'),
            ref('ronix_quality_manager.group_ronix_quality_admin'),
        ])]"/>
    </record>
</odoo>
