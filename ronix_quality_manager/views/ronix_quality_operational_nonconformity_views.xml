<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ronix_quality_operational_nonconformity_list" model="ir.ui.view">
        <field name="name">ronix.quality.operational.nonconformity.list</field>
        <field name="model">ronix.quality.operational.nonconformity</field>
        <field name="arch" type="xml">
            <list string="Operasyonel Uygunsuzluk Raporu" default_order="nonconformity_date desc, id desc">
                <field name="photo" widget="image" optional="show" options="{'size': [42, 42]}"/>
                <field name="location_id" optional="show"/>
                <field name="department_name"/>
                <field name="department_id" optional="hide"/>
                <field name="nonconformity_date"/>
                <field name="nonconformity_description_short" string="Açıklama"/>
                <field name="deadline_date" optional="hide"/>
                <field name="state"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ronix_quality_operational_nonconformity_form" model="ir.ui.view">
        <field name="name">ronix.quality.operational.nonconformity.form</field>
        <field name="model">ronix.quality.operational.nonconformity</field>
        <field name="arch" type="xml">
            <form string="Operasyonel Uygunsuzluk Raporu">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="department_id" class="oe_edit_only"/>
                        <h1>
                            <field name="department_id" placeholder="Departman Seçin" domain="[('location_id', '=', location_id), ('active', '=', True)]"/>
                        </h1>
                        <div invisible="department_id">
                            <field name="department_name" readonly="1"/>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="location_id"/>
                            <field name="nonconformity_date"/>
                            <field name="deadline_date"/>
                            <field name="department_name" invisible="1"/>
                            <field name="active" groups="base.group_no_one"/>
                        </group>
                        <group>
                            <field name="photo" widget="image" options="{'size': [300, 300]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Açıklama" name="description">
                            <field name="nonconformity_description" placeholder="Uygunsuzluk detayını buraya yazın..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ronix_quality_operational_nonconformity_search" model="ir.ui.view">
        <field name="name">ronix.quality.operational.nonconformity.search</field>
        <field name="model">ronix.quality.operational.nonconformity</field>
        <field name="arch" type="xml">
            <search string="Operasyonel Uygunsuzluk Raporu">
                <field name="location_id"/>
                <field name="department_id"/>
                <field name="department_name"/>
                <field name="state"/>
                <field name="nonconformity_date"/>
                <filter string="Aktif" name="active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Grupla">
                    <filter string="Lokasyon" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Departman" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Durum" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ronix_quality_operational_nonconformity" model="ir.actions.act_window">
        <field name="name">Operasyonel Uygunsuzluk Raporu</field>
        <field name="res_model">ronix.quality.operational.nonconformity</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ronix_quality_operational_nonconformity_search"/>
        <field name="groups_id" eval="[(6, 0, [
            ref('ronix_quality_manager.group_ronix_quality_user'),
            ref('ronix_quality_manager.group_ronix_quality_manager'),
            ref('ronix_quality_manager.group_ronix_quality_admin'),
        ])]"/>
    </record>
</odoo>
