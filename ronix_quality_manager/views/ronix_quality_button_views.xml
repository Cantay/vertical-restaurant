<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ronix_quality_button_list" model="ir.ui.view">
        <field name="name">ronix.quality.button.list</field>
        <field name="model">ronix.quality.button</field>
        <field name="arch" type="xml">
            <list string="Uygulama Butonlari" default_order="sequence asc, id asc">
                <field name="sequence" widget="handle"/>
                <field name="icon_image" widget="image" options="{'size': [48, 48]}"/>
                <field name="name"/>
                <field name="menu_type"/>
                <field name="location_id"/>
                <field name="mobile_route"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ronix_quality_button_form" model="ir.ui.view">
        <field name="name">ronix.quality.button.form</field>
        <field name="model">ronix.quality.button</field>
        <field name="arch" type="xml">
            <form string="Uygulama Butonu">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="location_id"/>
                            <field name="menu_type"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="icon_image" widget="image" class="oe_avatar"/>
                            <label for="mobile_route"/>
                            <div class="o_row">
                                <field name="mobile_route"/>
                                <button name="action_open_mobile_route"
                                        string="URL Ac"
                                        type="object"
                                        class="btn btn-secondary"/>
                            </div>
                            <field name="public_url" readonly="1" widget="url"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ronix_quality_button_search" model="ir.ui.view">
        <field name="name">ronix.quality.button.search</field>
        <field name="model">ronix.quality.button</field>
        <field name="arch" type="xml">
            <search string="Uygulama Butonlari">
                <field name="name"/>
                <field name="location_id"/>
                <field name="menu_type"/>
                <filter string="Aktif" name="active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Grupla">
                    <filter string="Lokasyon" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Menu Turu" name="group_menu_type" context="{'group_by': 'menu_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ronix_quality_button" model="ir.actions.act_window">
        <field name="name">Buttons</field>
        <field name="res_model">ronix.quality.button</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ronix_quality_button_search"/>
        <field name="context">{'search_default_group_location': 1}</field>
        <field name="groups_id" eval="[(6, 0, [
            ref('ronix_quality_manager.group_ronix_quality_user'),
            ref('ronix_quality_manager.group_ronix_quality_manager'),
            ref('ronix_quality_manager.group_ronix_quality_admin'),
        ])]"/>
    </record>
</odoo>
