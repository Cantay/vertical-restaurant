<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <!-- POS Kullanıcı Grubu -->
        <record id="group_pos_user" model="res.groups">
            <field name="name">POS Kullanıcısı</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- POS Yönetici Grubu -->
        <record id="group_pos_manager" model="res.groups">
            <field name="name">POS Yöneticisi</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_pos_user'))]"/>
        </record>

        <!-- POS Admin Grubu -->
        <record id="group_pos_admin" model="res.groups">
            <field name="name">POS Admin</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_pos_manager'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Çoklu Şirket Kuralı -->
        <record id="payment_provider_rule_company" model="ir.rule">
            <field name="name">Ödeme Sağlayıcı Şirket Kuralı</field>
            <field name="model_id" ref="payment.model_payment_provider"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="payment_transaction_rule_company" model="ir.rule">
            <field name="name">Ödeme İşlemi Şirket Kuralı</field>
            <field name="model_id" ref="payment.model_payment_transaction"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="pos_order_rule_company" model="ir.rule">
            <field name="name">POS Sipariş Şirket Kuralı</field>
            <field name="model_id" ref="model_pos_order"/>
            <field name="domain_force">['|', ('transaction_id.company_id', '=', False), ('transaction_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
